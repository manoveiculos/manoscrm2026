DATABASE_URL="postgresql://user:password@host:port/database"
DIRECT_URL="postgresql://user:password@host:port/database"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Meta Ads API
META_ACCESS_TOKEN=your-token
META_AD_ACCOUNT_ID=your-ad-account-id

# Google Ads API
GOOGLE_ADS_CLIENT_ID=your-client-id
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token




# WhatsApp Business API
WHATSAPP_BUSINESS_ID=your-whatsapp-biz-id
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token

# Google AI Studio (Gemini)
GOOGLE_AI_API_KEY=your-api-key

# n8n
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lead-capture

# --- Meta Conversions API (eventos de catálogo do site) -----------------------
# Pixel/dataset e token JÁ EXISTEM neste projeto: META_PIXEL_ID + META_ACCESS_TOKEN.
# Não foi criada META_CAPI_ACCESS_TOKEN — o token usado é o META_ACCESS_TOKEN.
META_PIXEL_ID=995826668986455
META_ACCESS_TOKEN=
META_API_VERSION=v26.0

# Modo teste: quando preenchido, TODOS os eventos vão pra aba "Testar eventos"
# do Gerenciador de Eventos e NÃO contam como conversão de produção.
# Deixe VAZIO em produção. Pra testar um evento só, mande test_event_code no payload.
META_TEST_EVENT_CODE=

# Segredo do endpoint /api/meta-capi/vehicle. Se preenchido, o site precisa mandar
# o header X-Meta-Capi-Secret. Sem isso o endpoint é aberto e qualquer um pode
# injetar Purchase no pixel.
META_CAPI_SITE_SECRET=

# Origens liberadas no CORS do endpoint (separadas por vírgula). Vazio = usa os
# domínios da Mano's (manosveiculos.com.br e manosveiculoscompra.com).
META_CAPI_ALLOWED_ORIGINS=
